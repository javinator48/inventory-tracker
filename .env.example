# Claude API key for photo identification, barcode fallback, value estimates and chat.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: Google Gemini API key for "Try it on" images of you wearing an outfit.
# Claude suggests the outfits; Gemini draws them. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the Gemini image model.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# SQLite file locally. For the cloud later, use a Turso URL (libsql://...) plus DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/inventory.db
DATABASE_AUTH_TOKEN=

# Where uploaded photos are stored.
UPLOAD_DIR=./data/uploads

# Optional: require this password to open the app. Set it before exposing the app beyond this PC.
APP_PASSWORD=
